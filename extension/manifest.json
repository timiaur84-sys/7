{
  "manifest_version": 3,
  "name": "DNG → PNG Converter",
  "version": "1.0.0",
  "description": "Batch convert DNG raw photos to PNG at full resolution and quality. Up to 100 images at once, fully offline.",
  "action": { "default_title": "DNG → PNG Converter" },
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
